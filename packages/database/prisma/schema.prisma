generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  MERCHANT
  ADMIN
}

enum BusinessType {
  GROCERY
  RESTAURANT
  SWEETS_SNACKS
  CLOTHING
  JEWELLERY
  TEMPLE_STORE
  AYURVEDIC_WELLNESS
  DISTRIBUTOR
  OTHER
}

enum MerchantVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum MerchantOrderStatus {
  PLACED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  CASH_ON_DELIVERY
}

// Auth.js Prisma adapter models. Adapter field names and mappings intentionally
// follow the official schema: https://authjs.dev/getting-started/adapters/prisma
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  phone         String?
  image         String?
  /// bcrypt hash for Credentials provider (Auth.js does not manage this field)
  passwordHash  String?
  role          UserRole  @default(CUSTOMER)
  emailVerified DateTime? @map("email_verified")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  merchant        Merchant?
  addresses       Address[]
  orders          Order[]         @relation("CustomerOrders")
  reviews         Review[]
  wishlistItems   Wishlist[]
  followedStores  FollowedStore[]
  raisedTickets   SupportTicket[] @relation("RaisedSupportTickets")
  assignedTickets SupportTicket[] @relation("AssignedAdminTickets")
  ticketMessages  TicketMessage[] @relation("TicketMessageAuthor")
  auditLogs       AuditLog[]      @relation("AuditLogActor")
  notifications   Notification[]

  @@index([role])
  @@map("users")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Merchant {
  id                       String                     @id @default(cuid())
  userId                   String                     @unique
  businessName             String
  businessType             BusinessType
  registrationNumber       String?
  /// Registered office address collected during onboarding.
  registeredAddress        String?
  verificationStatus       MerchantVerificationStatus @default(PENDING)
  verificationDocumentUrls String[]
  /// Whether the merchant operates a physical high-street / market store.
  hasPhysicalStore         Boolean                    @default(false)
  physicalStorePhotoUrl    String?
  /// Required for food-related business types (pickles, snacks, groceries, etc.).
  foodLicenseUrl           String?
  storeName                String
  storeSlug                String                     @unique
  storeLogoUrl             String?
  storeBannerUrl           String?
  storeDescription         String?                    @db.Text
  deliveryPostcodes        String[]
  avgRating                Decimal                    @default(0) @db.Decimal(3, 2)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  products       Product[]
  merchantOrders MerchantOrder[]
  coupons        Coupon[]
  followers      FollowedStore[]

  @@index([verificationStatus, createdAt])
  @@index([businessType])
}

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  iconUrl     String?
  parentId    String?
  isActive    Boolean @default(true)
  comingSoon  Boolean @default(false)
  sortOrder   Int     @default(0)

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId, isActive, sortOrder])
  @@index([isActive, sortOrder])
}

model Product {
  id            String        @id @default(cuid())
  merchantId    String
  categoryId    String
  name          String
  slug          String        @unique
  description   String        @db.Text
  priceInPence  Int
  stockQuantity Int
  sku           String
  status        ProductStatus @default(DRAFT)
  isFeatured    Boolean       @default(false)
  avgRating     Decimal       @default(0) @db.Decimal(3, 2)
  reviewCount   Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  merchant   Merchant       @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  orderItems OrderItem[]
  reviews    Review[]
  wishlists  Wishlist[]

  @@unique([merchantId, sku])
  @@index([merchantId, status])
  @@index([categoryId, status])
  @@index([status, createdAt])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Address {
  id        String  @id @default(cuid())
  userId    String?
  label     String
  line1     String
  line2     String?
  city      String
  county    String?
  postcode  String
  country   String  @default("GB")
  isDefault Boolean @default(false)

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId, isDefault])
  @@index([postcode])
}

model Order {
  id                    String        @id @default(cuid())
  orderNumber           String        @unique
  customerId            String?
  addressId             String
  totalInPence          Int
  deliveryFeeInPence    Int           @default(0)
  discountInPence       Int           @default(0)
  paymentStatus         PaymentStatus @default(PENDING)
  paymentMethod         PaymentMethod @default(CARD)
  stripePaymentIntentId String?       @unique
  checkoutSnapshot      Json?
  guestFirstName        String?
  guestLastName         String?
  guestEmail            String?
  guestPhone            String?
  placedAt              DateTime      @default(now())
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  customer       User?           @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  address        Address         @relation(fields: [addressId], references: [id], onDelete: Restrict)
  merchantOrders MerchantOrder[]

  @@index([customerId, placedAt])
  @@index([addressId])
  @@index([guestEmail])
  @@index([paymentStatus, createdAt])
  @@index([paymentMethod, paymentStatus])
}

model MerchantOrder {
  id              String              @id @default(cuid())
  orderId         String
  merchantId      String
  status          MerchantOrderStatus @default(PLACED)
  subtotalInPence Int
  trackingNumber  String?
  courierName     String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  merchant   Merchant    @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@unique([orderId, merchantId])
  @@index([merchantId, status, createdAt])
  @@index([orderId])
}

model OrderItem {
  id                   String @id @default(cuid())
  merchantOrderId      String
  productId            String
  productNameSnapshot  String
  priceInPenceSnapshot Int
  quantity             Int

  merchantOrder MerchantOrder @relation(fields: [merchantOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([merchantOrderId])
  @@index([productId])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  customerId String
  rating     Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now())

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer User    @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([productId, customerId])
  @@index([productId, createdAt])
  @@index([customerId, createdAt])
}

model Coupon {
  id                   String       @id @default(cuid())
  merchantId           String?
  code                 String       @unique
  discountType         DiscountType
  discountValue        Int
  minOrderValueInPence Int?
  expiresAt            DateTime
  usageLimit           Int?
  usedCount            Int          @default(0)

  merchant Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, expiresAt])
  @@index([expiresAt])
}

model Wishlist {
  id         String   @id @default(cuid())
  customerId String
  productId  String
  createdAt  DateTime @default(now())

  customer User    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([customerId, createdAt])
}

model FollowedStore {
  id         String   @id @default(cuid())
  customerId String
  merchantId String
  createdAt  DateTime @default(now())

  customer User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([customerId, merchantId])
  @@index([customerId, createdAt])
  @@index([merchantId])
}

model Banner {
  id         String   @id @default(cuid())
  imageUrl   String
  headline   String
  subtext    String?
  ctaText    String?
  ctaLink    String?
  startDate  DateTime
  endDate    DateTime
  isActive   Boolean  @default(true)
  comingSoon Boolean  @default(false)
  sortOrder  Int      @default(0)

  @@index([isActive, startDate, endDate])
  @@index([sortOrder])
}

model SupportTicket {
  id              String         @id @default(cuid())
  raisedByUserId  String
  subject         String
  priority        TicketPriority @default(MEDIUM)
  status          TicketStatus   @default(OPEN)
  assignedAdminId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  raisedBy      User            @relation("RaisedSupportTickets", fields: [raisedByUserId], references: [id], onDelete: Restrict)
  assignedAdmin User?           @relation("AssignedAdminTickets", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages      TicketMessage[]

  @@index([raisedByUserId, createdAt])
  @@index([assignedAdminId, status])
  @@index([status, priority, createdAt])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  message   String   @db.Text
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation("TicketMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@index([authorId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([type, createdAt])
}
