{
  "name": "@bharatmart/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./generated": {
      "types": "./generated/client/index.d.ts",
      "default": "./generated/client/index.js"
    }
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:wipe-marketplace": "tsx prisma/wipe-marketplace.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "build": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "@bharatmart/config": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.18.6",
    "bcryptjs": "^3.0.3",
    "prisma": "^6.19.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
