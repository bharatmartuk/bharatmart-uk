{
  "name": "@bharatmart/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./generated": {
      "types": "./generated/client/index.d.ts",
      "default": "./generated/client/index.js"
    }
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate-product-images": "tsx prisma/migrate-product-images-to-cloudinary.ts",
    "db:replace-new-product-images": "tsx prisma/replace-new-product-images.ts",
    "db:sync-category-marketplace": "tsx prisma/sync-category-marketplace.ts",
    "db:upload-merchant-logos": "tsx prisma/upload-merchant-logos.ts",
    "db:upload-favicon": "tsx prisma/upload-favicon.ts",
    "db:wipe-marketplace": "tsx prisma/wipe-marketplace.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "build": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "@bharatmart/config": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.18.6",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "dotenv": "^16.6.1",
    "prisma": "^6.19.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
